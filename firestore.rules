rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Legacy artifacts (homework still uses this; benchmark portfolios moved to /portfolios).
    match /artifacts/{artifactId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['benchmarkId','studentName','description','createdAt']) &&
                       request.resource.data.studentName is string &&
                       request.resource.data.studentName.size() > 0 &&
                       request.resource.data.studentName.size() <= 80 &&
                       request.resource.data.description.size() <= 500 &&
                       request.resource.data.createdAt == request.time;
      // Hard delete is denied for everyone (no login exists); the admin UI "delete"
      // is a SOFT delete — an update that sets deleted:true — so student work is
      // never destroyed by the web SDK and stays recoverable.
      allow delete: if false;
      // Only permit soft-delete style updates: identity fields stay immutable and
      // the update must be marking the doc deleted (deleted == true). This blocks
      // any anonymous overwrite of an existing artifact's content.
      allow update: if request.resource.data.benchmarkId == resource.data.benchmarkId &&
                       request.resource.data.studentName == resource.data.studentName &&
                       request.resource.data.deleted == true;
    }

    // Portfolios: per-benchmark student submissions with up to 5 slots
    // (image, video, code, cad, summary). Slots are file/link/text refs.
    match /portfolios/{portfolioId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['benchmarkId','studentName','createdAt','slots']) &&
                       request.resource.data.benchmarkId is string &&
                       request.resource.data.benchmarkId.size() <= 40 &&
                       request.resource.data.studentName is string &&
                       request.resource.data.studentName.size() > 0 &&
                       request.resource.data.studentName.size() <= 80 &&
                       request.resource.data.slots is map &&
                       request.resource.data.createdAt == request.time;
      // Hard delete denied; admin "delete" is a soft delete (update deleted:true).
      allow delete: if false;
      // Updates keep the identity fields immutable AND may never SHRINK the slots
      // map — this blocks the "blank a classmate's graded slots to {}" vector while
      // still allowing legitimate edits (adding/updating slots), setting a single
      // slot value to null (key stays, size unchanged), and soft-delete markers.
      allow update: if request.resource.data.slots is map &&
                       request.resource.data.benchmarkId == resource.data.benchmarkId &&
                       request.resource.data.studentName == resource.data.studentName &&
                       request.resource.data.slots.size() >= resource.data.slots.size();
    }

    // Archived collections: same model, separated for class history.
    match /archives/{archiveId}/artifacts/{artifactId} {
      allow read: if true;
      allow create: if true;
      allow delete: if false;
      allow update: if false;
    }
    match /archives/{archiveId}/portfolios/{portfolioId} {
      allow read: if true;
      allow create: if true;
      allow delete: if false;
      allow update: if false;
    }
    // Parent archive metadata doc: archivedAt + counts + optional admin note.
    // Lets the archive viewer list archives without scanning subcollections.
    match /archives/{archiveId} {
      allow read: if true;
      allow create: if request.resource.data.archivedAt is timestamp;
      allow update: if false;
      allow delete: if false;
    }

    // Exhibit: a curated wall of past student work (websites, Instructables,
    // builds). Public read; the admin-URL-token gate + honor code govern the
    // add/delete UI, so create stays permissive with light validation.
    match /exhibit/{exhibitId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['title','url','createdAt']) &&
                       request.resource.data.title is string &&
                       request.resource.data.title.size() > 0 &&
                       request.resource.data.title.size() <= 120 &&
                       request.resource.data.url is string &&
                       request.resource.data.url.size() <= 500 &&
                       request.resource.data.createdAt == request.time;
      // Hard delete denied; admin "remove" is a soft delete (update deleted:true).
      allow delete: if false;
      allow update: if request.resource.data.title == resource.data.title &&
                       request.resource.data.url == resource.data.url &&
                       request.resource.data.deleted == true;
    }

    // Class roster: students self-identify on first add. Honor-code class
    // means anyone can read/write; the slug-doc-id ensures we don't dupe.
    match /students/{studentSlug} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string &&
                                request.resource.data.name.size() > 0 &&
                                request.resource.data.name.size() <= 80;
      allow delete: if false;
    }

    // Per-student per-benchmark drafts. Doc id = `${nameSlug}__${benchmarkId}`.
    // Auto-save target for evidence uploads + reflection text. Promoted to
    // /portfolios on Submit and soft-cleared here (deleted:true). Permissive by
    // design, but never hard-deleted so nothing is lost mid-session.
    match /drafts/{draftId} {
      allow read: if true;
      allow create, update: if request.resource.data.studentName is string &&
                               request.resource.data.studentName.size() > 0 &&
                               request.resource.data.studentName.size() <= 80 &&
                               request.resource.data.benchmarkId is string &&
                               request.resource.data.benchmarkId.size() <= 40;
      allow delete: if false;
    }

    // Chem Images Wall (Chemistry class app, not D4SG): QR-upload photo wall.
    // Same soft-delete model as /exhibit; delete UI is gated by an admin URL token.
    match /chemWall/{imageId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['url','w','h','createdAt']) &&
                       request.resource.data.url is string &&
                       request.resource.data.url.size() <= 1000 &&
                       request.resource.data.w is number &&
                       request.resource.data.h is number &&
                       request.resource.data.createdAt == request.time;
      allow delete: if false;
      allow update: if request.resource.data.url == resource.data.url &&
                       request.resource.data.deleted == true;
    }

    // Surf Check journal (personal app, not D4SG): per-beach session log.
    // Same soft-delete model as /exhibit — entries are never hard-deleted.
    match /surfJournal/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['beachId','text','createdAt']) &&
                       request.resource.data.beachId is string &&
                       request.resource.data.beachId.size() <= 30 &&
                       request.resource.data.text is string &&
                       request.resource.data.text.size() > 0 &&
                       request.resource.data.text.size() <= 2000 &&
                       request.resource.data.createdAt == request.time &&
                       (!('name' in request.resource.data) ||
                        (request.resource.data.name is string &&
                         request.resource.data.name.size() <= 60));
      allow delete: if false;
      allow update: if request.resource.data.beachId == resource.data.beachId &&
                       request.resource.data.text == resource.data.text &&
                       request.resource.data.deleted == true;
    }

    // Secure assessment v2: only the server Admin SDK can access these.
    match /assessment_sessions/{id} { allow read, write: if false; }
    match /assessment_claims/{id} { allow read, write: if false; }
    match /assessment_attempts/{id} { allow read, write: if false; }

    // Legacy digital assessments. Unit 1 is migrated to the server API.
    // No login. Teacher-side writes (config, unblocks, result pulls) go through
    // the owner OAuth token, which bypasses rules entirely.
    // Config: the page reads title + salted password hash + open flag at start
    // AND at submit, so a password change takes effect live. Get-only.
    match /assessment_config/{assessmentId} {
      allow get: if assessmentId != 'unit1-atomic-structure';
      allow list: if false;
      allow create, update, delete: if false;
    }
    // Name claims: create-only IS the one-attempt lock. A second start with the
    // same name becomes an update and is denied; the app reads that denial as
    // "already taken". Never readable, never deletable from the client.
    match /assessment_names/{claimId} {
      allow read: if false;
      allow create: if !claimId.matches('unit1-atomic-structure__.*') && request.resource.data.name is string &&
                       request.resource.data.name.size() > 0 &&
                       request.resource.data.name.size() <= 80 &&
                       request.resource.data.at == request.time;
      allow update, delete: if false;
    }
    // Submissions: write-only from the client. Answers, tab events, and grades
    // are NEVER readable by any student; only the teacher's owner token reads.
    // Updates (autosave, tab events, final submit) allowed until submitted.
    match /assessment_subs/{subId} {
      allow read: if false;
      allow create: if !subId.matches('unit1-atomic-structure__.*') && request.resource.data.assessmentId != 'unit1-atomic-structure' && request.resource.data.name is string &&
                       request.resource.data.name.size() > 0 &&
                       request.resource.data.name.size() <= 80 &&
                       request.resource.data.submitted == false;
      allow update: if !subId.matches('unit1-atomic-structure__.*') && resource.data.assessmentId != 'unit1-atomic-structure' && resource.data.submitted == false;
      allow delete: if false;
    }
  }
}
