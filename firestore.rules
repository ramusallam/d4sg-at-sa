rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Identity model (2026-10-11): students sign in with their sonomaacademy.org
    // Google account; the roster below maps that email to the first name the
    // app has always stored as studentName / nameSlug, so nothing in the data
    // moved. A student can only read and write work under their own name. The
    // teacher (Google sign-in with the gmail below) reads and maintains all of it.
    function isTeacher() {
      return request.auth != null &&
             request.auth.token.email is string &&
             request.auth.token.email_verified == true &&
             request.auth.token.email.lower() in ['ramsey.musallam@gmail.com', 'ramsey.musallam@sonomaacademy.org'];
    }
    // GENERATED from roster.json by scripts/gen-roster.mjs. Do not edit here.
    function roster() {
      return {
        "alexa.torres@sonomaacademy.org": { "name": "Alexa", "slug": "alexa" },
        "aurora.martinez@sonomaacademy.org": { "name": "Aurora", "slug": "aurora" },
        "carina.flocco@sonomaacademy.org": { "name": "Carina", "slug": "carina" },
        "carter.mcginty@sonomaacademy.org": { "name": "Carter", "slug": "carter" },
        "dana.meyer@sonomaacademy.org": { "name": "Dana", "slug": "dana" },
        "dylan.castro@sonomaacademy.org": { "name": "Dylan", "slug": "dylan" },
        "franchesca.cohen@sonomaacademy.org": { "name": "Franchesca", "slug": "franchesca" },
        "gabriel.halstad@sonomaacademy.org": { "name": "Gabe", "slug": "gabe" },
        "henry.park@sonomaacademy.org": { "name": "Henry", "slug": "henry" },
        "isabella.rossi@sonomaacademy.org": { "name": "Isabella", "slug": "isabella" },
        "kai.fabricant@sonomaacademy.org": { "name": "Kai", "slug": "kai" },
        "katie.caffrey@sonomaacademy.org": { "name": "Katie", "slug": "katie" },
        "oona.hudson@sonomaacademy.org": { "name": "Oona", "slug": "oona" },
        "peter.hansen@sonomaacademy.org": { "name": "Peter", "slug": "peter" },
        "riley.musallam@sonomaacademy.org": { "name": "Riley", "slug": "riley" },
        "ryan.kimbel@sonomaacademy.org": { "name": "Ryan", "slug": "ryan" },
        "gregory.goode@sonomaacademy.org": { "name": "Weston", "slug": "weston" },
        "winter.holder@sonomaacademy.org": { "name": "Winter", "slug": "winter" },
      };
    }
    // END GENERATED ROSTER
    function userEmail() {
      return request.auth.token.email.lower();
    }
    function isStudent() {
      return request.auth != null &&
             request.auth.token.email is string &&
             request.auth.token.email_verified == true &&
             userEmail() in roster();
    }
    function myName() { return roster()[userEmail()].name; }
    function mySlug() { return roster()[userEmail()].slug; }
    // Existing docs are keyed by name. Older homework artifacts carry only
    // studentName, so ownership accepts either field.
    function owns(data) {
      return isStudent() &&
             (data.nameSlug == mySlug() || data.studentName == myName());
    }
    function writesAsSelf(data) {
      return isStudent() &&
             data.studentName == myName() &&
             data.nameSlug == mySlug();
    }

    // Legacy artifacts (homework still uses this; benchmark portfolios moved to /portfolios).
    match /artifacts/{artifactId} {
      allow read: if isTeacher() || owns(resource.data);
      allow create: if (isTeacher() || writesAsSelf(request.resource.data)) &&
                       request.resource.data.keys().hasAll(['benchmarkId','studentName','description','createdAt']) &&
                       request.resource.data.studentName is string &&
                       request.resource.data.studentName.size() > 0 &&
                       request.resource.data.studentName.size() <= 80 &&
                       request.resource.data.description.size() <= 500 &&
                       request.resource.data.createdAt == request.time;
      // Hard delete is denied for everyone. Teacher removal is a recoverable
      // soft delete; students cannot hide one another's homework entries.
      allow delete: if false;
      allow update: if isTeacher() &&
                       request.resource.data.benchmarkId == resource.data.benchmarkId &&
                       request.resource.data.studentName == resource.data.studentName &&
                       request.resource.data.deleted == true;
    }

    // Portfolios: per-benchmark student submissions with up to 5 slots
    // (image, video, code, cad, summary). Slots are file/link/text refs.
    match /portfolios/{portfolioId} {
      allow read: if isTeacher() || owns(resource.data);
      allow create: if (isTeacher() || writesAsSelf(request.resource.data)) &&
                       request.resource.data.keys().hasAll(['benchmarkId','studentName','createdAt','slots']) &&
                       request.resource.data.benchmarkId is string &&
                       request.resource.data.benchmarkId.size() <= 40 &&
                       request.resource.data.studentName is string &&
                       request.resource.data.studentName.size() > 0 &&
                       request.resource.data.studentName.size() <= 80 &&
                       request.resource.data.slots is map &&
                       request.resource.data.createdAt == request.time;
      // Hard delete denied. Students may keep revising their own stable
      // document; teacher-only maintenance may soft-remove or restore it.
      allow delete: if false;
      allow update: if request.resource.data.slots is map &&
                       request.resource.data.benchmarkId == resource.data.benchmarkId &&
                       request.resource.data.studentName == resource.data.studentName &&
                       (isTeacher() ||
                        (owns(resource.data) &&
                         request.resource.data.nameSlug == mySlug() &&
                         request.resource.data.slots.size() >= resource.data.slots.size() &&
                         (!('deleted' in request.resource.data) ||
                          request.resource.data.deleted == false)));
    }

    // Archived collections: same model, separated for class history.
    match /archives/{archiveId}/artifacts/{artifactId} {
      allow read, create: if isTeacher();
      allow delete: if false;
      allow update: if false;
    }
    match /archives/{archiveId}/portfolios/{portfolioId} {
      allow read, create: if isTeacher();
      allow delete: if false;
      allow update: if false;
    }
    // Parent archive metadata doc: archivedAt + counts + optional admin note.
    // Lets the archive viewer list archives without scanning subcollections.
    match /archives/{archiveId} {
      allow read: if isTeacher();
      allow create: if isTeacher() && request.resource.data.archivedAt is timestamp;
      allow update: if false;
      allow delete: if false;
    }

    // Exhibit: public to view, teacher-only to curate.
    match /exhibit/{exhibitId} {
      allow read: if true;
      allow create: if isTeacher() &&
                       request.resource.data.keys().hasAll(['title','url','createdAt']) &&
                       request.resource.data.title is string &&
                       request.resource.data.title.size() > 0 &&
                       request.resource.data.title.size() <= 120 &&
                       request.resource.data.url is string &&
                       request.resource.data.url.size() <= 500 &&
                       request.resource.data.createdAt == request.time;
      allow delete: if false;
      allow update: if isTeacher() &&
                       request.resource.data.title == resource.data.title &&
                       request.resource.data.url == resource.data.url &&
                       request.resource.data.deleted == true;
    }

    // Legacy self-added roster. The roster now lives in roster.json and
    // students never write here; kept readable for the teacher's history.
    match /students/{studentSlug} {
      allow read: if isTeacher();
      allow create, update: if isTeacher() &&
                               request.resource.data.name is string &&
                               request.resource.data.name.size() > 0 &&
                               request.resource.data.name.size() <= 80;
      allow delete: if false;
    }

    // Per-student per-benchmark drafts. Doc id = `${nameSlug}__${benchmarkId}`.
    // Auto-save target for evidence uploads + reflection text. Promoted to
    // /portfolios on Submit and soft-cleared here (deleted:true). Never
    // hard-deleted so nothing is lost mid-session.
    match /drafts/{draftId} {
      allow read: if isTeacher() || (isStudent() && draftId.matches('^' + mySlug() + '__.*'));
      allow create, update: if (isTeacher() || (writesAsSelf(request.resource.data) && draftId.matches('^' + mySlug() + '__.*'))) &&
                               request.resource.data.studentName is string &&
                               request.resource.data.studentName.size() > 0 &&
                               request.resource.data.studentName.size() <= 80 &&
                               request.resource.data.benchmarkId is string &&
                               request.resource.data.benchmarkId.size() <= 40;
      allow delete: if false;
    }

    // Chem Images Wall (Chemistry class app, not D4SG): QR-upload photo wall.
    // Same soft-delete model as /exhibit; delete UI is gated by an admin URL token.
    match /chemWall/{imageId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['url','w','h','createdAt']) &&
                       request.resource.data.url is string &&
                       request.resource.data.url.size() <= 1000 &&
                       request.resource.data.w is number &&
                       request.resource.data.h is number &&
                       request.resource.data.createdAt == request.time;
      allow delete: if false;
      allow update: if request.resource.data.url == resource.data.url &&
                       request.resource.data.deleted == true;
    }

    // Chemistry sub-day lesson work (Predicting Ion Charges app, not D4SG).
    // One doc per student (`${lesson}__${classSlug}__${nameSlug}`), autosaved as
    // they work. Honor-code class model: open read powers the live teacher
    // dashboard; no hard delete so student work is never destroyed.
    match /subWork/{workId} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string &&
                               request.resource.data.name.size() > 0 &&
                               request.resource.data.name.size() <= 80 &&
                               request.resource.data.lesson is string &&
                               request.resource.data.lesson.size() > 0 &&
                               request.resource.data.lesson.size() <= 60;
      allow delete: if false;
    }

    // Surf Check journal (personal app, not D4SG): per-beach session log.
    // Same soft-delete model as /exhibit — entries are never hard-deleted.
    match /surfJournal/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['beachId','text','createdAt']) &&
                       request.resource.data.beachId is string &&
                       request.resource.data.beachId.size() <= 30 &&
                       request.resource.data.text is string &&
                       request.resource.data.text.size() > 0 &&
                       request.resource.data.text.size() <= 2000 &&
                       request.resource.data.createdAt == request.time &&
                       (!('name' in request.resource.data) ||
                        (request.resource.data.name is string &&
                         request.resource.data.name.size() <= 60));
      allow delete: if false;
      allow update: if request.resource.data.beachId == resource.data.beachId &&
                       request.resource.data.text == resource.data.text &&
                       request.resource.data.deleted == true;
    }

    // Secure assessment v2: only the server Admin SDK can access these.
    match /assessment_sessions/{id} { allow read, write: if false; }
    match /assessment_claims/{id} { allow read, write: if false; }
    match /assessment_attempts/{id} { allow read, write: if false; }

    // Legacy digital assessments. Unit 1 is migrated to the server API.
    // No login. Teacher-side writes (config, unblocks, result pulls) go through
    // the owner OAuth token, which bypasses rules entirely.
    // Config: the page reads title + salted password hash + open flag at start
    // AND at submit, so a password change takes effect live. Get-only.
    match /assessment_config/{assessmentId} {
      allow get: if assessmentId != 'unit1-atomic-structure';
      allow list: if false;
      allow create, update, delete: if false;
    }
    // Name claims: create-only IS the one-attempt lock. A second start with the
    // same name becomes an update and is denied; the app reads that denial as
    // "already taken". Never readable, never deletable from the client.
    match /assessment_names/{claimId} {
      allow read: if false;
      allow create: if !claimId.matches('unit1-atomic-structure__.*') && request.resource.data.name is string &&
                       request.resource.data.name.size() > 0 &&
                       request.resource.data.name.size() <= 80 &&
                       request.resource.data.at == request.time;
      allow update, delete: if false;
    }
    // Submissions: write-only from the client. Answers, tab events, and grades
    // are NEVER readable by any student; only the teacher's owner token reads.
    // Updates (autosave, tab events, final submit) allowed until submitted.
    match /assessment_subs/{subId} {
      allow read: if false;
      allow create: if !subId.matches('unit1-atomic-structure__.*') && request.resource.data.assessmentId != 'unit1-atomic-structure' && request.resource.data.name is string &&
                       request.resource.data.name.size() > 0 &&
                       request.resource.data.name.size() <= 80 &&
                       request.resource.data.submitted == false;
      allow update: if !subId.matches('unit1-atomic-structure__.*') && resource.data.assessmentId != 'unit1-atomic-structure' && resource.data.submitted == false;
      allow delete: if false;
    }
  }
}
